# OpenRouter API Key
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# =============================================================================
# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard
# =============================================================================

# Supabase Project URL (e.g., https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Supabase Anonymous Key (public, safe for frontend)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (secret, backend only - DO NOT expose to frontend)
SUPABASE_SERVICE_KEY=

# Supabase JWT Secret (for verifying tokens - found in Project Settings > API)
SUPABASE_JWT_SECRET=

# =============================================================================
# Stripe Configuration (for paid tiers)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/
# =============================================================================

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Stripe Webhook Secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for subscription tiers
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
